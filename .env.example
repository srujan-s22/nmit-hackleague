# ==============================================================================
# NMIT HACKLEAGUE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# NEXT.JS APPLICATION SETTINGS
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# SUPABASE LOCAL OR HOSTED CONFIGURATION (Phase 3 & Phase 4)
# Local Supabase defaults:
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Service role key must NEVER be exposed to the browser bundle:
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# CRYPTOGRAPHIC & SECURITY SECRETS
# Dedicated HMAC secret for unauthenticated rate limiting (min 32 chars):
RATE_LIMIT_HMAC_SECRET=local-development-rate-limit-hmac-secret-min-32-chars-long

# Shared secret for scheduled deletion worker and maintenance cron:
CRON_SECRET=local-development-cron-worker-secret-token-32-chars

# RESEND TRANSACTIONAL EMAIL (Hosted Production SMTP)
# Local development routes email to Inbucket on port 54324
# RESEND_API_KEY=re_your_api_key_here
